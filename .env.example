# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon). Uses sslmode=verify-full automatically.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb

# Secret used to sign auth session tokens (better-auth / AUTH_SECRET).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Public base URL of the app. Only one is needed; NEXT_PUBLIC_APP_URL is the
# variant inlined into client bundles. Defaults to http://localhost:3000.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=http://localhost:3000
# AUTH_URL=http://localhost:3000

# OpenAI API key — enables the AI product-listing auto-fill on /sell.
# OPENAI_API_KEY=

# Web Push (VAPID) keys — enables browser push notifications.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 4-digit backup pin required before an admin password can be reset.
# ADMIN_RESET_PIN=1285